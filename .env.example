# ============================================================
#  视频下载站 环境配置
#  用法：cp .env.example .env  然后按需修改
#  docker compose 会自动读取本目录下的 .env
# ============================================================

# ------------------------------------------------------------
# 服务端口
# ------------------------------------------------------------
# 对外访问端口
APP_PORT=8000
# 监听地址。用 Nginx 反代时会被 deploy.sh --proxy 自动改成 127.0.0.1
# （只允许本机反代访问，避免绕过 Nginx 直连 8000）
APP_BIND=0.0.0.0

# ------------------------------------------------------------
# 抖音解析引擎（Evil0ctal / Douyin_TikTok_Download_API）
# 默认用公共演示实例，有限流，仅适合自用。
# 生产建议自托管，见 README「上线部署」；自托管后把地址换成自己的。
# ------------------------------------------------------------
DTK_BASE_URL=https://api.douyin.wtf
DTK_USERNAME=demo
DTK_PASSWORD=kelp-kelp-delta-3690

# ------------------------------------------------------------
# 哔哩哔哩解析
# ------------------------------------------------------------
# 可选。不配置也能用，但**未登录时最高只能拿到 720P**。
#
# 推荐做法：什么都不用填，直接在网页上点「扫码登录」——
#   每个访客用自己的账号登录，凭据按浏览器会话隔离，重启后需重新扫码。
#
# 下面这个 BILI_COOKIE 是**服务端级统一账号**：适合「这台服务器就我一个人用，
# 不想每次重新扫码」。填了之后所有访客都用这个账号的权益，优先级低于访客
# 自己的扫码登录（谁扫码登录了就用谁自己的账号，不会串号）。
#
# 获取方式：
#   1) 浏览器登录 bilibili.com
#   2) F12 → Application → Cookies → 复制 SESSDATA 的值
#   3) 填成：BILI_COOKIE=SESSDATA=xxxxxx
# 注意：Cookie 等同账号凭据，请勿外泄，也不要提交到 Git。
BILI_COOKIE=

# ------------------------------------------------------------
# 哔哩哔哩风控调优（一般无需改动）
# ------------------------------------------------------------
# B 站接口前面有一层风控网关，判定「这个请求像不像真实浏览器」。命中会直接
# 返回 HTTP 412。代码已自动做四层防护（设备指纹 / 浏览器请求头 / 请求节流 /
# 412 换指纹重试），正常情况不用碰下面这几项。
#
# 只有在「服务器出口 IP 已被 B 站批量风控」这种极端情况下才需要调整。

# 设备指纹（buvid3 / buvid4 / b_nut）缓存时长，秒。默认 6 小时。
# 调小 = 更频繁换指纹（更容易绕过风控，但每次解析多两次请求）。
BILI_FP_TTL=21600

# 命中 412 后「换一套指纹重试」的次数。默认 2（即最多发 3 次）。
# 设 0 表示不重试，直接报错。
BILI_412_RETRY=2

# 两次 B 站接口请求之间的全局最小间隔，秒。默认 0.2。
# 机房 IP 对突发请求敏感，这个节流是降低被拦概率的有效手段。
# 设 0 关闭（更快，但更容易被拦）；调大更稳但解析更慢。
BILI_MIN_INTERVAL=0.2

# ------------------------------------------------------------
# ffmpeg（DASH 高清档位需要）
# ------------------------------------------------------------
# 1080P60 / 4K / HDR 这类档位在 B 站只以 DASH 形式提供（音视频两条独立流），
# 浏览器没法自己合并，需要服务端用 ffmpeg 无损封装成一个 MP4。
#
# docker compose 部署：镜像**已内置 ffmpeg**，这里留空即可。
# 裸机部署：装了 ffmpeg 且在 PATH 里就留空；装在非标准路径时填绝对路径。
# 没装 ffmpeg 也能正常用，只是这些高清档位不会出现在列表里（MP4 档位不受影响）。
#
# ⚠️ 程序会**真实执行** `ffmpeg -version` 来确认它跑得起来，而不是只看文件在不在。
#    因为 Windows 上用 WinGet 安装时，PATH 里那个 ffmpeg.exe 可能是一个
#    **0 字节的 reparse point**（shim），存在却无法执行，报了
#    `[WinError 193] 不是有效的 Win32 应用程序`。这种情况请把 FFMPEG_BIN 指向
#    真实的可执行文件，例如：
#      FFMPEG_BIN=C:/Users/你/AppData/Local/Microsoft/WinGet/Packages/
#                 Gyan.FFmpeg_xxx/ffmpeg-9.0.2-full_build/bin/ffmpeg.exe
#
# 示例（Windows 本地调试）：
#   FFMPEG_BIN=F:/tools/ffmpeg/bin/ffmpeg.exe
FFMPEG_BIN=

# ------------------------------------------------------------
# 国内网络加速（强烈建议保留）
# ------------------------------------------------------------
# 容器内 pip 装依赖走清华源。不配的话国内构建容易卡住。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 备用 pip 源（可选）。主源临时缺包或限流时会自动兜底，避免单点故障
# 让整个构建失败。留空即不启用。
#   PIP_EXTRA_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PIP_EXTRA_INDEX_URL=

# 基础镜像兜底通道：服务器连不上 Docker Hub 时，放开下面两行指向国内镜像源。
# 推荐先执行 sudo bash deploy/fix-docker-mirror.sh（会自动配好 registry-mirrors），
# 只有在加速源也不可用时才需要手动指定。
# BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# ------------------------------------------------------------
# 下载域名白名单（一般无需配置）
# 为防止 /api/download 被当成开放代理，只放通抖音 / B 站的 CDN 域名。
# 若平台更换了 CDN 域名导致下载 400，可在此追加关键字（逗号分隔）。
# ------------------------------------------------------------
EXTRA_DOUYIN_HOSTS=
EXTRA_BILIBILI_HOSTS=
